print(f"Width: {width}, Height: {height}")

##exploring sets, main difference compared to list and tuples are sets automatically remove duplicate elements 
and also sets dont have indexing so it means you cant print item from specific position because there's no first item.
in addition each time we print the sets, the result of the order might change due to how sets work so if i want something thats
of specific order then sets are not suitable.
numbers = {1, 2, 2, 3, 3, 4}
#refer to screenshot pss47 in readme.md for result
print(numbers)

#adding and removing item in sets
fruits.add("date")
fruits.remove("banana")

#Sets also support mathematical set operations like union, intersection, and difference
set1 = {1, 2, 3}
set2 = {3, 4, 5}
print(set1.union(set2))  # Union, only print 3 once because its duplicated.

#intersection, it compares both sets and print the value thats identical in both sets in this case "3".
It is a powerful way to quickly find overlaps between two groups of data.
print(set1.intersection(set2))  

#difference. this compares the two sets and tell you which items appear in the first set but didnt appear in the second set in this case "1" and
"2" is the answer 
print(set1.difference(set2))  

#if i want to search an element in the set, i can use "in". it will print either true or false, a boolean
print("apple" in fruits)
